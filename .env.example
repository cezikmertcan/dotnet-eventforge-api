# Local development values. Never commit the real .env file.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080

MONGO_CONNECTION_STRING=mongodb://localhost:27017
MONGO_DATABASE_NAME=eventforge
REDIS_CONNECTION_STRING=localhost:6379
REDIS_INSTANCE_NAME=eventforge:

JWT_ISSUER=EventForge.Api
JWT_AUDIENCE=EventForge.Client
JWT_SIGNING_KEY=replace-with-a-long-local-development-key-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=30

# Optional first-admin bootstrap. Leave blank to disable automatic seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=EventForge Admin
